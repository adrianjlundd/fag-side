  "visdat\\index.html": "<!doctype html>\n<html lang=\"nb\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"theme-color\" content=\"#102e30\" />\n    <title>Grunnleggende visuell databehandling · Visdat TDT4195</title>\n    <link rel=\"stylesheet\" href=\"stil.css\" />\n    <script defer src=\"cg.js\"></script>\n    <script defer src=\"ip.js\"></script>\n    <script defer src=\"figurer.js\"></script>\n    <script defer src=\"side.js\"></script>\n  </head>\n  <body data-page=\"home\">\n    <a class=\"skip\" href=\"#innhold\">Hopp til innhold</a>\n    <header class=\"mast\">\n      <div class=\"shell mast-inner\">\n        <a class=\"brand\" href=\"./\" aria-label=\"Visdat, fagforsiden\"\n          ><span class=\"brandmark\" aria-hidden=\"true\"\n            ><i></i><i></i><i></i><i></i></span\n          >Visdat</a\n        ><span class=\"brand-code\">TDT4195</span>\n        <nav aria-label=\"Hovedmeny\">\n          <a href=\"./#pensum\">Pensum</a\n          ><a href=\"eksamen.html\">Eksamenstrening</a\n          ><a href=\"begreper.html\">Begreper</a>\n        </nav>\n      </div>\n    </header>\n    <main class=\"shell\" id=\"innhold\">\n      <section class=\"hero\">\n        <div class=\"hero-copy\">\n          <p class=\"eyebrow\">\n            <span class=\"signal\"></span> NTNU &nbsp;/&nbsp; HØST 2026\n          </p>\n          <h1>Grunnleggende<br />visuell<br /><em>databehandling</em></h1>\n          <p class=\"lede\">\n            Fra geometri til piksler, fra piksler til mening. Lær pensum steg\n            for steg og prøv metodene på eksamensoppgaver.\n          </p>\n          <div class=\"actions\">\n            <a class=\"button primary\" href=\"tema.html?k=transformasjoner\"\n              >Start læringsstien</a\n            ><a class=\"button\" href=\"eksamen.html\">Eksamenstrening</a>\n          </div>\n        </div>\n        <figure class=\"surface\">\n          <div class=\"instrument-title\">\n            <span>HØYDEFELT</span><span>z = f(x, y)</span>\n          </div>\n          <canvas\n            id=\"heightfield\"\n            width=\"720\"\n            height=\"430\"\n            role=\"img\"\n            aria-label=\"Et høydefelt av punkter og trekanter. Flere prøver viser terrenget mer detaljert.\"\n          ></canvas>\n          <figcaption>\n            <label for=\"sampler\">Prøvetetthet</label\n            ><input\n              id=\"sampler\"\n              type=\"range\"\n              min=\"8\"\n              max=\"44\"\n              value=\"30\"\n            /><output for=\"sampler\" id=\"samplevalue\">30 × 30</output>\n          </figcaption>\n        </figure>\n      </section>\n      <section id=\"pensum\" class=\"curriculum\">\n        <div class=\"section-head\">\n          <div>\n            <p class=\"eyebrow\">LÆRINGSSTIEN</p>\n            <h2>Pensum i to deler</h2>\n          </div>\n          <p>Velg et tema eller følg kapitlene i rekkefølge.</p>\n        </div>\n        <div class=\"tracks\" id=\"tracks\"></div>\n      </section>\n      <section class=\"exam-callout\">\n        <div>\n          <p class=\"eyebrow\">EKSAMENSTRENING</p>\n          <h2>Prøv deg på tidligere eksamener</h2>\n          <p>\n            Følg et helt sett i original rekkefølge, eller tren på én ferdighet\n            om gangen.\n          </p>\n        </div>\n        <div class=\"actions\">\n          <a class=\"button\" href=\"eksamen.html?aar=2024\">Høst 2024</a\n          ><a class=\"button\" href=\"eksamen.html?aar=2025\">Høst 2025</a>\n        </div>\n      </section>\n    </main>\n    <footer class=\"shell\">\n      <span><b>Visdat</b> · TDT4195 · NTNU H26</span\n      ><a href=\"kilder.html\">Om pensum og kilder</a>\n    </footer>\n    <noscript\n      ><p>\n        Slå på JavaScript for å vise kapitler, begreper og oppgaver.\n      </p></noscript\n    >\n  </body>\n</html>\n",
